# Electron binary downloads default to github.com, which is unreachable from this
# network. npmmirror serves the same artifacts and is reachable.
# Remove these two lines if your network can reach github.com directly.
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
